NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai_interview_copilot
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
MAX_RESUME_SIZE_MB=5
STORAGE_PROVIDER=local
# Production resume storage (required when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOG_LEVEL=info
# Set only when deployed behind a trusted reverse proxy, for example: 1
TRUST_PROXY=
# Optional values used only by the demo-data seed script
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=
DEMO_NAME=Demo User
